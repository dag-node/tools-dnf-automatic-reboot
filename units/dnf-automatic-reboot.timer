[Unit]
Description=dnf-automatic with inhibitor and conditional reboot
Documentation=file:///usr/share/doc/dnf-automatic-reboot/README
ConditionPathExists=!/run/ostree-booted
Wants=network-online.target

[Timer]
OnCalendar=
# Late night EU, low US usage
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=600

# If the system was off when the timer would have fired, run immediately
# on next boot (within the window).
Persistent=true

[Install]
WantedBy=timers.target

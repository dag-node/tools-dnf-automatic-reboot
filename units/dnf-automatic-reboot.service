[Unit]
Description=dnf-automatic with shutdown inhibitor and conditional reboot
Documentation=file:///usr/share/doc/dnf-automatic-reboot/README
After=network-online.target time-sync.target
Wants=network-online.target
# Order startup after time synchronization so RPM INSTALLTIME entries written
# by dnf, and the boot-time comparison in needs-restarting, see the correct
# wall-clock time.  This is ordering only: time-sync.target is reached even
# when chrony-wait.service fails, and at once when nothing is ordered before
# it (systemd-time-wait-sync.service is absent on UEK R8).  run.sh requires
# the synchronisation itself: it runs `chronyc waitsync`, bounded by
# clock_sync_wait_sec, and installs nothing until chronyd confirms the clock.
# The RPM %post enables chrony-wait.service when [time] enable_chrony_wait =
# yes, which makes the ordering wait at boot too.
# Prerequisite on this host (see doc/README):
#   /etc/chrony.conf must contain: makestep 1 -1
Requires=time-sync.target
# Prevent a second instance starting if one is already running.
ConditionPathExists=!/run/dnf-automatic-reboot.lock
# The watchdog holds this file while it checks and kills a stuck run, so no
# new run can start in between and be killed in its place.
ConditionPathExists=!/run/dnf-automatic-reboot.recovery
# Present from a reboot request until the reboot, or until
# /usr/libexec/dnf-automatic-reboot/cancel-reboot.sh cancels it.
ConditionPathExists=!/run/dnf-automatic-reboot.reboot-pending
# A failed run is otherwise visible only in the journal; %n names the unit.
OnFailure=dnf-automatic-reboot-notify@%n.service

[Service]
Type=oneshot
# Create lock file before run.sh starts so ConditionPathExists works
ExecStartPre=/usr/bin/touch /run/dnf-automatic-reboot.lock
ExecStart=/usr/libexec/dnf-automatic-reboot/run.sh
# run.sh removes the lock on clean exit; belt-and-suspenders removal here
ExecStopPost=/usr/bin/rm -f /run/dnf-automatic-reboot.lock
RemainAfterExit=no
# run.sh owns all its own timeouts via the `timeout` command.
# Do not let systemd kill it independently.
TimeoutStartSec=infinity
# needs-restarting output is translated; the parsers match C strings.
Environment=LC_ALL=C
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dnf-automatic-reboot

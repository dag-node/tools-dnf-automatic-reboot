[Unit]
Description=dnf-automatic-reboot watchdog check
Documentation=file:///usr/share/doc/dnf-automatic-reboot/README
# Intentionally has no After= dependency on the main service so it runs
# independently even when the main service is hung.
OnFailure=dnf-automatic-reboot-notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/dnf-automatic-reboot/watchdog.sh
RemainAfterExit=no
# A oneshot has no start timeout by default.  A watchdog that hangs never
# exits, so the timer cannot start the next cycle.  watchdog.sh's slowest
# path, the kill and up to 300 s to confirm it, ends well inside this.
TimeoutStartSec=15min
# The recovery file never outlives the watchdog.  watchdog.sh removes it on
# exit; this covers a watchdog killed at the timeout, which would otherwise
# keep the main unit from starting until the next boot.  A pending reboot is
# held by /run/dnf-automatic-reboot.reboot-pending, which is not touched here.
ExecStopPost=/usr/bin/rm -f /run/dnf-automatic-reboot.recovery
# needs-restarting output is translated; the parsers match C strings.
Environment=LC_ALL=C
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dnf-automatic-watchdog
